# PostgreSQL connection string (required)
# Local example: postgresql://postgres:postgres@localhost:5432/outreach
DATABASE_URL="postgresql://user:password@localhost:5432/outreach"

# Groq — used by draft generation (https://console.groq.com)
GROQ_API_KEY="your-groq-api-key"

# Resend — used by send queue (https://resend.com)
RESEND_API_KEY="your-resend-api-key"
RESEND_WEBHOOK_SECRET="your-resend-webhook-secret"

# Apollo — used by ICP import and enrichment
APOLLO_API_KEY="your-apollo-api-key"

# Optional: public app URL (webhooks, absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
